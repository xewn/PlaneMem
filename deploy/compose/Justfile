set dotenv-load := true

compose := "docker compose --env-file .env.example -f docker-compose.yml"

up:
    {{compose}} up -d

down:
    {{compose}} down

reset:
    {{compose}} down -v --remove-orphans
    {{compose}} up -d

migrate:
    {{compose}} exec -T postgres psql -U planemem -d planemem -f /docker-entrypoint-initdb.d/001_baseline.sql
    {{compose}} exec -T postgres psql -U planemem -d planemem -f /docker-entrypoint-initdb.d/002_contracts.sql
    {{compose}} exec -T postgres psql -U planemem -d planemem -f /docker-entrypoint-initdb.d/003_artifacts.sql
    {{compose}} exec -T postgres psql -U planemem -d planemem -f /docker-entrypoint-initdb.d/004_sessions.sql
    {{compose}} exec -T postgres psql -U planemem -d planemem -f /docker-entrypoint-initdb.d/005_sync.sql
    {{compose}} exec -T postgres psql -U planemem -d planemem -f /docker-entrypoint-initdb.d/006_outbox.sql
    {{compose}} exec -T postgres psql -U planemem -d planemem -f /docker-entrypoint-initdb.d/007_audit.sql
    {{compose}} exec -T postgres psql -U planemem -d planemem -f /docker-entrypoint-initdb.d/009_runtime_state.sql
    {{compose}} exec -T postgres psql -U planemem -d planemem -f /docker-entrypoint-initdb.d/010_session_continuity_persistence.sql

seed:
    {{compose}} exec -T postgres psql -U planemem -d planemem -f /seed/seed.sql

doctor:
    node health/doctor.mjs
