COMPOSE_PROJECT_NAME=planemem
WORKCTX_IMAGE=ghcr.io/planemem/platform:0.1.0
WORKCTX_PORT=3000
PROPOSAL_ENABLED=false
VECTOR_ENABLED=false
PLANE_IMAGE=makeplane/plane-backend:v0.26.0
POSTGRES_IMAGE=postgres:16.4-alpine
POSTGRES_DB=planemem
POSTGRES_USER=planemem
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_IMAGE=redis:7.4.1-alpine
REDIS_PORT=6379
NATS_IMAGE=nats:2.10.22-alpine
NATS_PORT=4222
NATS_MONITOR_PORT=8222
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0.5
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PORT=8081
MINIO_IMAGE=minio/minio:RELEASE.2024-10-13T13-34-11Z
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
AI_MEMORY_IMAGE=ghcr.io/akitaonrails/ai-memory:3.0.0
AI_MEMORY_MODE=local
AI_MEMORY_PORT=8787
AI_MEMORY_AUTH_TOKEN=
MEMORY_PROVIDER_MODE=ai-memory-mcp
MEMORY_ENABLED=true
MEMORY_REQUIRED=true
AI_MEMORY_TOKEN=
MEMORY_ACTOR_ID=planemem-platform
MEMORY_CLIENT_ID=planemem-platform
OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.107.0
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
