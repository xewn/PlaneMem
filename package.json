{
  "name": "@planemem/work-continuity-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "prettier --check \".github/**/*.yml\" \"packages/**/*.{ts,mjs,json}\" \"apps/**/*.{ts,mjs,json}\" \"tests/**/*.{mjs,js,ts,json}\" \"tools/**/*.{mjs,js,ts,json}\" \"deploy/**/*.{yml,yaml,mjs,json}\" \"integrations/**/*.{yml,yaml,json}\" \"*.{json,yaml,yml,mjs,ts}\"",
    "typecheck": "tsc --noEmit",
    "test": "node tools/run-module-tests.mjs",
    "contract-test": "node tools/run-module-tests.mjs --contract",
    "test:contract": "node tools/run-module-tests.mjs --contract",
    "test:module": "node tools/run-module-tests.mjs",
    "test:functional": "node tools/run-functional-tests.mjs",
    "test:resilience": "node tools/run-resilience-tests.mjs",
    "test:vulnerability": "node tools/run-image-vulnerability-scan.mjs",
    "test:security": "node tools/run-security-tests.mjs",
    "test:identity-audit": "node tools/run-identity-audit-live-probe.mjs",
    "test:performance": "node tools/run-performance-tests.mjs",
    "test:e2e": "node tools/run-functional-tests.mjs",
    "test:evaluation": "node tools/run-evaluation-tests.mjs",
    "test:release": "node tools/run-release-tests.mjs",
    "test:memory-live": "node tools/run-ai-memory-live-probe.mjs",
    "test:sqlite-live": "node --import tsx tools/run-sqlite-live-probe.mjs",
    "test:wavemate-live": "node tools/run-wavemate-live-probe.mjs",
    "test:wavemate-ui-live": "node tools/run-wavemate-ui-live-probe.mjs",
    "test:workbench-realistic": "node tools/run-realistic-workbench-acceptance.mjs",
    "test:workbench-ui-realistic": "node tools/run-realistic-web-console-smoke.mjs",
    "plan:audit": "node tools/plan-audit.mjs",
    "rc:readiness": "node tools/rc-readiness.mjs",
    "release:manifest": "node tools/release-manifest-cli.mjs generate",
    "sbom:generate": "node tools/sbom-cli.mjs generate",
    "deploy:k3s": "node tools/k3s-release.mjs",
    "fixture:validate": "node tools/fixture-cli.mjs validate",
    "fixture:seed": "node tools/fixture-cli.mjs seed",
    "fixture:events": "node tools/fixture-cli.mjs events",
    "fixture:backup": "node tools/fixture-cli.mjs backup",
    "evidence:bundle": "node tools/evidence-cli.mjs bundle"
  },
  "devDependencies": {
    "@planemem/contracts": "workspace:*",
    "@planemem/artifact-service": "workspace:*",
    "@planemem/context-compiler": "workspace:*",
    "@planemem/context-service": "workspace:*",
    "@planemem/context-bridge": "workspace:*",
    "@planemem/api-gateway": "workspace:*",
    "@planemem/auth": "workspace:*",
    "@planemem/audit-service": "workspace:*",
    "@planemem/domain": "workspace:*",
    "@planemem/evaluation": "workspace:*",
    "@planemem/intelligence": "workspace:*",
    "@planemem/observability": "workspace:*",
    "@planemem/policy-service": "workspace:*",
    "@planemem/release": "workspace:*",
    "@planemem/search-service": "workspace:*",
    "@planemem/integration-orchestrator": "workspace:*",
    "@planemem/events": "workspace:*",
    "@planemem/plane-connector": "workspace:*",
    "@planemem/sdk": "workspace:*",
    "@planemem/session-service": "workspace:*",
    "@planemem/sync-service": "workspace:*",
    "@planemem/mcp-gateway": "workspace:*",
    "@planemem/workctx-cli": "workspace:*",
    "@planemem/web-console": "workspace:*",
    "@planemem/test-fixtures": "workspace:*",
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  }
}
