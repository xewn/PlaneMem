{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "workers/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/dist", "apps/web-console/src", "apps/web-console/.next"]
}
