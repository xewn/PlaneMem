  "info": {
    "title": "PlaneMem Canonical Event v1 message catalog",
    "version": "0.1.0",
    "description": "Source-only reusable message components for all 38 types in the default EventTypeRegistry. Each payload is the complete custom CanonicalEvent, not only its nested payload. This catalog deliberately declares no server, channel, operation, broker binding or delivery guarantee. It is not a CloudEvents 1.0 structured message. Validation, generation and runtime compatibility have not been executed."
  },
  "defaultContentType": "application/json",
  "x-todo": "P0-01",
  "x-scope": "reusable-message-catalog-only",
  "x-canonical-schema-version": 1,
  "x-schema-loading": "Load ../schemas/canonical-v1-catalog.json and all four sibling event schemas locally with their $id mappings. Do not fetch planemem.local. A consumer must explicitly support JSON Schema 2020-12 in Multi Format Schema payloads; this format is not assumed to be every AsyncAPI tool's default.",
  "x-runtime-boundaries": [
    "event_id is the deduplication identity; optional correlation_id and causation_id are separate from required trace_id.",
    "Preserve tenant/workspace/project scope, source_refs and sensitivity; none of them grants authorization.",
    "All default types use schema_version 1; custom registry types or versions require a separate coordinated contract update.",
    "Most business payloads remain open objects in the existing base schema; deletion and restoration have additional structural constraints.",
    "Payload semantics, restore equality/version arithmetic, processing side effects, durable ordering/retries and broker acknowledgement are outside structural validation."
  ],
