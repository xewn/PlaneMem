{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planemem.local/schemas/work-item-restored.json",
  "title": "WorkItemRestored canonical event constraints, in addition to the v1 envelope",
  "type": "object",
  "required": [
    "event_type",
    "schema_version",
    "aggregate_type",
    "project_id",
    "causation_id",
    "payload"
  ],
  "description": "Runtime additionally requires causation_id to equal restored_from.event_id, a distinct event_id, and aggregate_version exactly one greater than the referenced deletion. The worker verifies the committed deletion and current tombstones.",
  "properties": {
    "event_type": { "const": "WorkItemRestored" },
    "schema_version": { "const": 1 },
    "aggregate_type": { "const": "work_item" },
    "project_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "causation_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "aggregate_version": { "type": "integer", "minimum": 2, "maximum": 9007199254740991 },
    "payload": {
      "type": "object",
      "required": ["external_id", "title", "status", "restored_from"],
      "properties": {
        "external_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "Runtime rejects surrounding whitespace, dot paths, controls and lone surrogates."
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
        "status": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "\\S" },
        "restored_from": {
          "type": "object",
          "required": ["event_id", "aggregate_version"],
          "additionalProperties": false,
          "properties": {
            "event_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
            "aggregate_version": { "type": "integer", "minimum": 1, "maximum": 9007199254740990 }
          }
        }
      }
    }
  }
}
