{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planemem.local/schemas/canonical-cloudevent.json",
  "$anchor": "CanonicalCloudEventV1",
  "title": "PlaneMem Canonical Event v1 in CloudEvents 1.0 structured JSON",
  "description": "Closed PlaneMem profile, not a general CloudEvents validator. The complete serialized envelope is limited to 1 MiB by the adapter. Load this and all five sibling event schemas locally. Cross-field id/type/time/subject equality, expected source, URL parsing, calendar validity, Unicode scalar strings, JSON depth/nodes and business rules require the adapter. Format assertions depend on validator configuration. No authentication or transport is implied.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "id", "source", "type", "datacontenttype", "subject", "time", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "$ref": "#/$defs/canonicalId" },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "format": "uri",
      "not": { "pattern": "[\\s\\u0000-\\u001f\\u007f]" },
      "allOf": [
        { "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[A-Za-z0-9:/?#\\[\\]@!$&'()*+,;=._~%\\-]+$" },
        { "pattern": "^(?:[^%]|%[0-9A-Fa-f]{2})*$" }
      ]
    },
    "type": {
      "type": "string",
      "pattern": "^com\\.planemem\\.[A-Z][A-Za-z0-9]+\\.v1$(?![\\s\\S])"
    },
    "datacontenttype": { "const": "application/json" },
    "subject": { "type": "string", "minLength": 1 },
    "time": { "$ref": "#/$defs/utcTime" },
    "data": {
      "allOf": [{ "$ref": "canonical-v1-catalog.json" }],
      "properties": {
        "occurred_at": { "$ref": "#/$defs/utcTime" },
        "event_id": { "$ref": "#/$defs/canonicalId" },
        "tenant_id": { "$ref": "#/$defs/canonicalId" },
        "workspace_id": { "$ref": "#/$defs/canonicalId" },
        "project_id": { "$ref": "#/$defs/canonicalId" },
        "aggregate_id": { "$ref": "#/$defs/canonicalId" },
        "actor_id": { "$ref": "#/$defs/canonicalId" },
        "session_id": { "$ref": "#/$defs/canonicalId" },
        "correlation_id": { "$ref": "#/$defs/canonicalId" },
        "causation_id": { "$ref": "#/$defs/canonicalId" }
      }
    }
  },
  "$defs": {
    "canonicalId": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "utcTime": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 30,
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$(?![\\s\\S])"
    }
  }
}
