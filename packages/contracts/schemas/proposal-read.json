{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planemem.local/schemas/proposal-read.json",
  "title": "Proposal directory, complete detail and submission identity v1",
  "description": "Three existing HTTP GET success shapes. Read-only observations and capability hints do not authorize a later command, confirm source application or prove an original creation/review receipt.",
  "$comment": "Manually authored source contract, not a new runtime validator. Gateway validates selected stored metadata, provenance and local-source manifests, but does not parse the complete result against this schema. SDK listProposals/getProposal use the generic envelope reader. Cross-field identity, ETag, ordering and source equality require runtime checks; no response byte budget or tool compatibility is established here.",
  "oneOf": [
    { "$ref": "#ProposalListEnvelope" },
    { "$ref": "#ProposalDetailEnvelope" },
    { "$ref": "#ProposalSubmissionContextEnvelope" }
  ],
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "kind": { "enum": ["decision", "risk", "next_step", "blocker", "brief"] },
    "status": { "enum": ["proposed", "verified", "rejected"] },
    "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "text": { "type": "string" },
    "nonempty": { "type": "string", "minLength": 1 },
    "nullableText": { "type": ["string", "null"] },
    "utcTime": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}|[+-][0-9]{6})-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "$comment": "Gateway converts finite stored dates with Date.toISOString(), including extended years. Pattern is not independent calendar validation."
    },
    "sourceRef": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "$ref": "#/$defs/nonempty" },
        "id": { "$ref": "#/$defs/nonempty" },
        "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "uri": { "$ref": "#/$defs/nonempty" }
      },
      "additionalProperties": true,
      "$comment": "validateSourceRef preserves stored extensions. Nonempty type/id/uri need not be trimmed, URI-valid or ULIDs. context-item sources additionally require a positive pinned revision."
    },
    "proposalSource": {
      "$ref": "#/$defs/sourceRef",
      "if": { "properties": { "type": { "const": "context-item" } }, "required": ["type"] },
      "then": {
        "required": ["revision"],
        "properties": { "revision": { "$ref": "#/$defs/version" } }
      }
    },
    "pinnedProposalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "revision"],
      "properties": {
        "type": { "const": "proposal" },
        "id": { "$ref": "#/$defs/ulid" },
        "revision": { "$ref": "#/$defs/version" }
      }
    },
    "origin": {
      "$anchor": "ProposalOrigin",
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "revision"],
      "properties": {
        "proposal_id": { "$ref": "#/$defs/ulid" },
        "revision": { "$ref": "#/$defs/version" }
      },
      "description": "Saved derivation provenance. Does not inherit the parent's decision or prove its current revision still equals this saved revision."
    },
    "listQuery": {
      "$anchor": "ProposalListQuery",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "kind": { "$ref": "#/$defs/kind" },
        "before": { "$ref": "#/$defs/ulid" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
        "derived_from": { "$ref": "#/$defs/ulid" }
      },
      "description": "Decoded filters; no empty-string aliases. before is an exclusive proposal ID, not a signed/bound cursor. derived_from selects direct children only. HTTP limit accepts ASCII digits including leading zeros, then converts and checks 1..100."
    },
    "detailQuery": {
      "$anchor": "ProposalDetailQuery",
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id"],
      "properties": { "proposal_id": { "$ref": "#/$defs/ulid" } },
      "description": "Decoded internal query; HTTP supplies this ID through the path and accepts no URL query fields."
    },
    "emptyQuery": {
      "$anchor": "ProposalSubmissionContextQuery",
      "type": "object",
      "additionalProperties": false
    },
    "summary": {
      "$anchor": "ProposalSummary",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "kind",
        "title",
        "status",
        "revision",
        "classification",
        "created_at",
        "expires_at"
      ],
      "properties": {
        "proposal_id": { "$ref": "#/$defs/ulid" },
        "kind": { "$ref": "#/$defs/kind" },
        "title": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" },
        "revision": { "$ref": "#/$defs/version" },
        "classification": { "$ref": "#/$defs/classification" },
        "created_at": { "$ref": "#/$defs/utcTime" },
        "expires_at": { "$ref": "#/$defs/utcTime" }
      },
      "description": "Stored metadata only, without content/provenance/reviewer/source-manifest validation. Handler checks ID, safe positive revision and dates; kind/status/classification rely on storage constraints. Expired proposals retain their saved status and remain readable when visible."
    },
    "document": {
      "$anchor": "ProposalDocument",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "proposal_id",
        "tenant_id",
        "workspace_id",
        "project_id",
        "kind",
        "title",
        "content",
        "status",
        "revision",
        "classification",
        "source_refs",
        "provenance",
        "created_by",
        "created_by_client",
        "created_at",
        "expires_at",
        "trace_id",
        "reviewed_by",
        "reviewed_by_client",
        "reviewed_at",
        "review_reason"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "proposal_id": { "$ref": "#/$defs/ulid" },
        "tenant_id": { "$ref": "#/$defs/nonempty" },
        "workspace_id": { "$ref": "#/$defs/nonempty" },
        "project_id": { "$ref": "#/$defs/nonempty" },
        "kind": { "$ref": "#/$defs/kind" },
        "title": { "$ref": "#/$defs/text" },
        "content": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" },
        "revision": { "$ref": "#/$defs/version" },
        "classification": { "$ref": "#/$defs/classification" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/proposalSource" }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true,
          "required": ["model_version", "prompt_version", "warnings"],
          "properties": {
            "model_version": { "$ref": "#/$defs/text" },
            "prompt_version": { "$ref": "#/$defs/text" },
            "warnings": { "type": "array", "items": { "type": "string" } },
            "derived_from": { "$ref": "#ProposalOrigin" }
          }
        },
        "created_by": { "$ref": "#/$defs/text" },
        "created_by_client": { "$ref": "#/$defs/text" },
        "created_at": { "$ref": "#/$defs/utcTime" },
        "expires_at": { "$ref": "#/$defs/utcTime" },
        "trace_id": { "$ref": "#/$defs/text" },
        "reviewed_by": { "$ref": "#/$defs/nullableText" },
        "reviewed_by_client": { "$ref": "#/$defs/nullableText" },
        "reviewed_at": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/utcTime" }] },
        "review_reason": { "$ref": "#/$defs/nullableText" },
        "source_manifest": false
      },
      "description": "Complete saved proposal. Gateway spreads the stored row, removes internal source_manifest, normalizes dates/revision and sets schema_version. Preserve other stored extensions. Create-time text limits/normalization are not independently reapplied by reads. Migration 018 constrains proposed to revision1/null review fields and final states to revision2/non-null review fields; this reader does not independently recheck that relationship. It checks provenance, local-source pins and manifest hash syntax, not full original-command/event integrity."
    },
    "page": {
      "$anchor": "ProposalPage",
      "type": "object",
      "additionalProperties": false,
      "required": ["proposals", "review_allowed", "create_allowed", "restricted_read"],
      "properties": {
        "proposals": { "type": "array", "maxItems": 100, "items": { "$ref": "#ProposalSummary" } },
        "next_before": { "$ref": "#/$defs/ulid" },
        "review_allowed": { "type": "boolean" },
        "create_allowed": { "type": "boolean" },
        "restricted_read": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "required": ["next_before"] },
          "then": { "properties": { "proposals": { "minItems": 1 } } }
        }
      ],
      "description": "HTTP always emits all three hints, though the generic TypeScript page makes two optional. Select filtered limit+1 rows, return at most limit in descending proposal_id order, emit next_before only when lookahead exists and equal to the last returned ID. No has_more/count/snapshot field. Hints use current context capabilities/client/human flag, without independent expiry or future Policy approval."
    },
    "listEnvelope": {
      "$anchor": "ProposalListEnvelope",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trace_id", "source_refs", "data"],
      "properties": {
        "schema_version": { "const": 1 },
        "trace_id": { "$ref": "#/$defs/nonempty" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id"],
            "properties": {
              "type": { "const": "proposal-list" },
              "id": { "$ref": "#/$defs/nonempty" }
            }
          }
        },
        "data": { "$ref": "#ProposalPage" }
      },
      "description": "Source ID equals requested project; trace is the current read. No outer scope, revision, etag or server_cursor."
    },
    "detailEnvelope": {
      "$anchor": "ProposalDetailEnvelope",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trace_id", "source_refs", "data", "revision", "etag"],
      "properties": {
        "schema_version": { "const": 1 },
        "trace_id": { "$ref": "#/$defs/nonempty" },
        "source_refs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 33,
          "prefixItems": [{ "$ref": "#/$defs/pinnedProposalSource" }],
          "items": { "$ref": "#/$defs/proposalSource" }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proposal", "sources_current", "review_allowed"],
          "properties": {
            "proposal": { "$ref": "#ProposalDocument" },
            "sources_current": { "type": "boolean" },
            "review_allowed": { "type": "boolean" }
          }
        },
        "revision": { "$ref": "#/$defs/version" },
        "etag": { "type": "string", "pattern": "^W/\"version-[1-9][0-9]*\"$" }
      },
      "description": "Outer revision/etag and first source bind the saved proposal ID/revision; remaining sources equal proposal.source_refs in order. Outer trace is this read, proposal.trace_id is the saved trace. sources_current checks only pinned local context items and their dependency manifests in this transaction; external source_refs are not fetched, and an empty local manifest yields true. review_allowed is independent of status/expiry/sources_current and is not authorization. No server_cursor."
    },
    "submissionContextEnvelope": {
      "$anchor": "ProposalSubmissionContextEnvelope",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trace_id", "source_refs", "data"],
      "properties": {
        "schema_version": { "const": 1 },
        "trace_id": { "$ref": "#/$defs/nonempty" },
        "source_refs": { "type": "array", "maxItems": 0 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity_preconditions",
            "actor_id",
            "client_id",
            "tenant_id",
            "workspace_id",
            "project_id"
          ],
          "properties": {
            "identity_preconditions": { "const": 1 },
            "actor_id": { "$ref": "#/$defs/nonempty" },
            "client_id": { "$ref": "#/$defs/nonempty" },
            "tenant_id": { "$ref": "#/$defs/nonempty" },
            "workspace_id": { "$ref": "#/$defs/nonempty" },
            "project_id": { "$ref": "#/$defs/nonempty" }
          }
        }
      },
      "description": "Current verified client and authenticated actor/scope only. No expiry, capabilities, proposal ID, original request, storage/project availability or permission grant. Direct HTTP handler returns before command routing; this is not a persisted command receipt."
    }
  }
}
