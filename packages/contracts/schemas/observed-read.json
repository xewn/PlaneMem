{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planemem.local/schemas/observed-read.json",
  "title": "Saved Plane observations, work-item directory and context summary v1",
  "description": "Complete success union for project state, work-item state, work-item context and observation directory. Plane observation versions are not local work-item revisions. A context_pack here is a transient search summary, not a saved ContextPackReceipt.",
  "$comment": "Source-only independent schema. Runtime enforces UTF-16 record/query/restore/memory limits, scalar validity, calendar equality, request/scope/source/version bindings, cursor identity and page ordering. Directory title/status use Unicode scalar lengths. Gateway parses snapshots and directory pages, but assembles context without the full shared context parser; SDK additionally parses context and checks outer trace/source equality. No validator/generator/runtime evidence or complete byte-budget guarantee.",
  "oneOf": [
    { "$ref": "#ObservedProjectEnvelope" },
    { "$ref": "#ObservedWorkItemEnvelope" },
    { "$ref": "#ObservedContextEnvelope" },
    { "$ref": "#ObservedDirectoryEnvelope" }
  ],
  "$defs": {
    "recordId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "allOf": [
        { "not": { "enum": [".", ".."] } },
        { "not": { "pattern": "^\\s|\\s$" } },
        { "not": { "pattern": "[\\u0000-\\u001f\\u007f]" } }
      ],
      "$comment": "Already trimmed, nonblank, <=255 UTF-16 units; runtime also rejects lone surrogates. Interior whitespace is allowed."
    },
    "ulid": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "nonnegative": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "utcTime": {
      "type": "string",
      "minLength": 24,
      "maxLength": 27,
      "pattern": "^(?:[0-9]{4}|[+-][0-9]{6})-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "$comment": "Finite Date.parse with exact toISOString roundtrip, including extended years. Pattern does not independently validate calendar dates."
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "workspace_id", "project_id"],
      "properties": {
        "tenant_id": { "$ref": "#/$defs/recordId" },
        "workspace_id": { "$ref": "#/$defs/recordId" },
        "project_id": { "$ref": "#/$defs/recordId" }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/nonnegative" },
        "uri": { "type": "string", "minLength": 1 }
      },
      "description": "validateSourceRef accepts nonempty strings without trim/URI syntax checking and preserves extensions on memory results."
    },
    "snapshotSource": {
      "$ref": "#/$defs/sourceRef",
      "propertyNames": { "enum": ["type", "id", "revision", "uri"] },
      "description": "Snapshot parser reconstructs these four public source fields, dropping stored source extensions."
    },
    "restoreReference": {
      "$anchor": "PlaneRestoreReference",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "aggregate_version"],
      "properties": {
        "event_id": { "$ref": "#/$defs/ulid" },
        "aggregate_version": { "$ref": "#/$defs/version" }
      },
      "description": "References immediately preceding deletion: aggregate_version=plane_version-1, event ID differs from current source_event_id, and fields.restored_from equals this reference. Cross-field relationships checked by existing parser."
    },
    "projectInput": {
      "$anchor": "ObservedProjectReadInput",
      "type": "object",
      "additionalProperties": false,
      "properties": { "project_id": { "$ref": "#/$defs/recordId" } },
      "description": "Shared local input allows omitted project_id to mean current project; HTTP uses a required path ID. Different current-project input is rejected by client parser, while Gateway path mismatch returns404."
    },
    "workItemInput": {
      "$anchor": "ObservedWorkItemReadInput",
      "type": "object",
      "additionalProperties": false,
      "required": ["work_item_id"],
      "properties": { "work_item_id": { "$ref": "#/$defs/recordId" } },
      "description": "External Plane ID or event aggregate ID in the current project. Not an implicit local wcp_work_items.id mapping; HTTP uses path, no query fields."
    },
    "snapshot": {
      "$anchor": "ObservedSnapshot",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "workspace_id",
        "project_id",
        "entity_kind",
        "external_id",
        "aggregate_id",
        "authority",
        "plane_version",
        "observed_at",
        "source_event_id",
        "source_refs",
        "classification",
        "fields"
      ],
      "properties": {
        "schema_version": { "enum": [1, 2] },
        "tenant_id": { "$ref": "#/$defs/recordId" },
        "workspace_id": { "$ref": "#/$defs/recordId" },
        "project_id": { "$ref": "#/$defs/recordId" },
        "entity_kind": { "enum": ["Project", "WorkItem"] },
        "external_id": { "$ref": "#/$defs/recordId" },
        "aggregate_id": { "$ref": "#/$defs/ulid" },
        "authority": { "const": "plane" },
        "plane_version": { "$ref": "#/$defs/version" },
        "observed_at": { "$ref": "#/$defs/utcTime" },
        "source_event_id": { "$ref": "#/$defs/ulid" },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/snapshotSource" } },
        "classification": { "$ref": "#/$defs/classification" },
        "fields": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "external_id": {
              "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/recordId" }]
            }
          },
          "description": "Saved event payload, not a fabricated current Plane object. If external_id is absent/null it falls back to aggregate_id; otherwise it must match external_id. Outer status equals fields.status when it is a string, and must be absent otherwise."
        },
        "status": { "type": "string" },
        "deleted_at": { "$ref": "#/$defs/utcTime" },
        "restored_from": { "$ref": "#PlaneRestoreReference" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "schema_version": { "const": 2 } },
            "required": ["schema_version"]
          },
          "then": {
            "required": ["deleted_at"],
            "properties": {
              "entity_kind": { "const": "WorkItem" },
              "status": false,
              "restored_from": false,
              "fields": {
                "type": "object",
                "additionalProperties": false,
                "required": ["external_id"],
                "properties": { "external_id": { "$ref": "#/$defs/recordId" } }
              }
            }
          },
          "else": { "properties": { "deleted_at": false } }
        },
        {
          "if": { "required": ["restored_from"] },
          "then": {
            "properties": {
              "schema_version": { "const": 1 },
              "entity_kind": { "const": "WorkItem" },
              "plane_version": { "minimum": 2 },
              "fields": {
                "required": ["external_id", "restored_from", "title", "status"],
                "properties": {
                  "external_id": { "$ref": "#/$defs/recordId" },
                  "restored_from": { "$ref": "#PlaneRestoreReference" },
                  "title": { "type": "string", "pattern": "\\S", "maxLength": 2000 },
                  "status": { "type": "string", "pattern": "\\S", "maxLength": 255 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fields": { "required": ["status"], "properties": { "status": { "type": "string" } } }
            },
            "required": ["fields"]
          },
          "then": { "required": ["status"] },
          "else": { "properties": { "status": false } }
        }
      ],
      "description": "Normalized saved observation. Requested ID must equal external_id or aggregate_id; Project requests additionally equal authorized project. Deleted v2 has deleted_at=observed_at and fields.external_id only. Active v1 omits deleted_at; top-level restored_from is emitted only for source WorkItemRestored, not inferred from arbitrary fields of later updates. Classification is the matched index classification, not the directory's parent/index maximum."
    },
    "envelopeFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trace_id", "source_refs", "data"],
      "properties": {
        "schema_version": { "const": 1 },
        "trace_id": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "data": { "type": "object" }
      },
      "description": "Outer schema_version stays1 even for deletion snapshot2. No outer revision/etag/server_cursor or HTTP ETag; observation version belongs inside data. SDK compares current trace and exact normalized sources with data."
    },
    "projectEnvelope": {
      "$anchor": "ObservedProjectEnvelope",
      "$ref": "#/$defs/envelopeFields",
      "properties": {
        "data": {
          "$ref": "#ObservedSnapshot",
          "properties": { "entity_kind": { "const": "Project" }, "schema_version": { "const": 1 } }
        },
        "source_refs": { "items": { "$ref": "#/$defs/snapshotSource" } }
      },
      "description": "Project state; outer sources equal the snapshot sources in order."
    },
    "workItemEnvelope": {
      "$anchor": "ObservedWorkItemEnvelope",
      "$ref": "#/$defs/envelopeFields",
      "properties": {
        "data": {
          "$ref": "#ObservedSnapshot",
          "properties": { "entity_kind": { "const": "WorkItem" } }
        },
        "source_refs": { "items": { "$ref": "#/$defs/snapshotSource" } }
      },
      "description": "Work-item active/deleted/restored state; outer sources equal snapshot sources in order."
    },
    "hit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "workspace_id",
        "project_id",
        "id",
        "title",
        "snippet",
        "revision",
        "score",
        "rank_source",
        "classification",
        "source_refs"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "tenant_id": { "$ref": "#/$defs/recordId" },
        "workspace_id": { "$ref": "#/$defs/recordId" },
        "project_id": { "$ref": "#/$defs/recordId" },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "snippet": { "type": "string" },
        "revision": { "$ref": "#/$defs/nonnegative" },
        "score": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "rank_source": { "enum": ["fts", "memory"] },
        "classification": { "$ref": "#/$defs/classification" },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "localHit": {
      "$ref": "#/$defs/hit",
      "properties": {
        "id": { "pattern": "^plane:WorkItem:" },
        "title": { "maxLength": 1000 },
        "revision": { "$ref": "#/$defs/version" },
        "score": { "const": 1 },
        "rank_source": { "const": "fts" },
        "source_refs": { "items": { "$ref": "#/$defs/snapshotSource" } }
      },
      "description": "First hit is synthesized from work_item, not a fresh FTS query: ID=plane:WorkItem:external_id, revision/classification/sources match snapshot. Title is fields.title when nonblank, else external_id, then slice(0,1000); snippet is title plus parenthesized status or observed."
    },
    "memoryHit": {
      "$ref": "#/$defs/hit",
      "properties": {
        "id": { "$ref": "#/$defs/recordId" },
        "title": { "const": "ai-memory" },
        "snippet": { "maxLength": 65536 },
        "rank_source": { "const": "memory" },
        "classification": { "const": "restricted" },
        "source_refs": { "maxItems": 64 }
      },
      "description": "Deduplicated provider page_ref, first occurrence retained, in provider order; score=1/(unique memory index+1), independent of the preceding local hit. Full returned provider batch is checked before selecting at most19. Source extensions survive HTTP but SDK reconstructs public source fields."
    },
    "context": {
      "$anchor": "ObservedWorkItemContext",
      "type": "object",
      "additionalProperties": false,
      "required": ["work_item", "context_pack"],
      "properties": {
        "work_item": {
          "$ref": "#ObservedSnapshot",
          "properties": { "schema_version": { "const": 1 }, "entity_kind": { "const": "WorkItem" } }
        },
        "context_pack": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "query",
            "trace_id",
            "degraded",
            "backend",
            "memory_used",
            "vector_used",
            "hits",
            "source_refs"
          ],
          "properties": {
            "schema_version": { "const": 1 },
            "query": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "trace_id": { "type": "string", "minLength": 1 },
            "degraded": { "type": "boolean" },
            "backend": { "const": "postgres" },
            "memory_used": { "type": "boolean" },
            "vector_used": { "const": false },
            "hits": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "prefixItems": [{ "$ref": "#/$defs/localHit" }],
              "items": { "$ref": "#/$defs/memoryHit" }
            },
            "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } }
          },
          "allOf": [
            {
              "if": {
                "properties": { "memory_used": { "const": false } },
                "required": ["memory_used"]
              },
              "then": { "properties": { "hits": { "maxItems": 1 } } },
              "else": { "properties": { "degraded": { "const": false } } }
            }
          ]
        }
      },
      "description": "Transient context assembled after saved-state read, without one transaction spanning memory recall. query equals local hit title, pack.trace_id equals outer trace, sources deduplicate (type,id) with first full ref retained. memory_used=true can accompany zero external hits; configured successful empty recall is not degradation. Server does not invoke complete context parser; SDK additionally requires nonblank query/hit titles, unique memory IDs, exact scope/local hit and source relationships. A pathological title whose first1000 UTF-16 units are whitespace can therefore be emitted by server but rejected by client."
    },
    "contextEnvelope": {
      "$anchor": "ObservedContextEnvelope",
      "$ref": "#/$defs/envelopeFields",
      "properties": { "data": { "$ref": "#ObservedWorkItemContext" } },
      "description": "Outer sources equal context_pack.source_refs, after first-occurrence deduplication across saved and memory hit sources. Optional memory failure can return degraded local-only200; required failure returns an error."
    },
    "directoryQuery": {
      "$anchor": "ObservedWorkItemListQuery",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 500,
          "not": { "pattern": "[\\u0000-\\u001f\\u007f]" },
          "default": ""
        },
        "state": { "enum": ["active", "deleted", "all"], "default": "active" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
        "cursor": { "$ref": "#/$defs/cursor" }
      },
      "description": "Decoded query; trim query after raw500-UTF16/control/lone-surrogate checks. ASCII-insensitive substring search over external ID, aggregate ID and active title. Cursor key binds trimmed query with original case, scope/actor/client/restricted/state/limit; case-only query change invalidates continuation despite equivalent search matching."
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9_-]{1,4096}$",
      "description": "Base64url JSON [2,query fingerprint,last external ID]. Server checks shape/version/key/last ID, not canonical byte re-encoding or a signature. Not an authorization token or snapshot."
    },
    "directoryEntry": {
      "$anchor": "ObservedWorkItemEntry",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_id",
        "aggregate_id",
        "plane_version",
        "source_event_id",
        "event_type",
        "state",
        "title",
        "status",
        "classification",
        "observed_at",
        "deleted_at"
      ],
      "properties": {
        "external_id": { "$ref": "#/$defs/recordId" },
        "aggregate_id": { "$ref": "#/$defs/ulid" },
        "source_event_id": { "$ref": "#/$defs/ulid" },
        "plane_version": { "$ref": "#/$defs/version" },
        "event_type": {
          "enum": [
            "WorkItemCreated",
            "WorkItemUpdated",
            "WorkItemStatusConfirmed",
            "WorkItemDeleted",
            "WorkItemRestored"
          ]
        },
        "state": { "enum": ["active", "deleted"] },
        "title": { "type": ["string", "null"], "maxLength": 2000 },
        "status": { "type": ["string", "null"], "maxLength": 255 },
        "classification": { "$ref": "#/$defs/classification" },
        "observed_at": { "$ref": "#/$defs/utcTime" },
        "deleted_at": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/utcTime" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "deleted" } }, "required": ["state"] },
          "then": {
            "properties": {
              "event_type": { "const": "WorkItemDeleted" },
              "title": { "type": "null" },
              "status": { "type": "null" },
              "deleted_at": { "$ref": "#/$defs/utcTime" }
            }
          },
          "else": {
            "properties": {
              "event_type": { "not": { "const": "WorkItemDeleted" } },
              "deleted_at": { "type": "null" },
              "title": { "type": "string", "pattern": "\\S" }
            }
          }
        },
        {
          "if": {
            "properties": { "event_type": { "const": "WorkItemRestored" } },
            "required": ["event_type"]
          },
          "then": { "properties": { "plane_version": { "minimum": 2 } } }
        }
      ],
      "description": "Current metadata, not payload/history/local work item. Deleted timestamp equals observed_at and no title/status retained. Active title/status are SQL LEFT2000/255 Unicode scalars; blank title falls back to external ID. Classification is parent/index maximum with unknown class conservatively restricted."
    },
    "directoryPage": {
      "$anchor": "ObservedWorkItemPage",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "scope", "checked_at", "items"],
      "properties": {
        "schema_version": { "const": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "checked_at": { "$ref": "#/$defs/utcTime" },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#ObservedWorkItemEntry" }
        },
        "next_cursor": { "$ref": "#/$defs/cursor" }
      },
      "allOf": [
        {
          "if": { "required": ["next_cursor"] },
          "then": { "properties": { "items": { "minItems": 1 } } }
        }
      ],
      "description": "Items strictly ascending/distinct by external_id under Unicode-scalar/C collation, filtered before limit+1. Only first limit entries normalized/validated; lookahead metadata is not independently validated. next_cursor present only with lookahead, full requested page and last returned external ID; no has_more/count/history. checked_at is SQL statement_timestamp, not snapshot observed_at or proof of latest upstream Plane state."
    },
    "directoryEnvelope": {
      "$anchor": "ObservedDirectoryEnvelope",
      "$ref": "#/$defs/envelopeFields",
      "properties": {
        "source_refs": { "maxItems": 0 },
        "data": { "$ref": "#ObservedWorkItemPage" }
      },
      "description": "Empty outer sources are intentional metadata-directory behavior. No state payload, live Plane request, saved ContextPack or consumer cursor update."
    }
  }
}
