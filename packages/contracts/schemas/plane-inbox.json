{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planemem.local/schemas/plane-inbox.json",
  "title": "PlaneMem visible Plane inbox metadata",
  "description": "Source-only complete list, summary, event-detail and version-diagnosis successes. These are processing metadata, not canonical event bodies, payloads, projection state or proofs of upstream completeness.",
  "$comment": "Standalone schema. Runtime additionally checks decimal numerical bounds, real canonical UTC dates, exact requested scope/IDs, query/order/cursor relationships, count arithmetic and diagnostic version comparisons. No generation, validator, SDK/Mock machine-contract consumption or runtime evidence.",
  "oneOf": [
    { "$ref": "#PlaneInboxListEnvelope" },
    { "$ref": "#PlaneInboxSummaryEnvelope" },
    { "$ref": "#PlaneInboxDetailEnvelope" },
    { "$ref": "#PlaneInboxDiagnosisEnvelope" }
  ],
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$",
      "$comment": "Canonical nonnegative decimal <=9223372036854775807; lexical pattern alone does not enforce bigint upper bound. Never coerce to JavaScript number."
    },
    "revision": { "$ref": "#/$defs/decimal", "not": { "const": "0" } },
    "aggregateVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,15}$",
      "$comment": "Runtime positive bound9007199254740991, unlike queue revision/attempt count bigint. Preserve string representation."
    },
    "time": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}|[+-][0-9]{6})-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "$comment": "Finite Date.parse and exact toISOString roundtrip, including extended years. PostgreSQL dates are normalized to milliseconds. Pattern does not independently check real calendar validity."
    },
    "nullableTime": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
    "errorCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
    "nullableError": { "anyOf": [{ "$ref": "#/$defs/errorCode" }, { "type": "null" }] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "workspace_id", "project_id"],
      "properties": {
        "tenant_id": { "$ref": "#/$defs/ulid" },
        "workspace_id": { "$ref": "#/$defs/ulid" },
        "project_id": { "$ref": "#/$defs/ulid" }
      }
    },
    "identityText": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "\\S",
      "not": { "pattern": "[\\u0000-\\u001f\\u007f]" },
      "$comment": "Nonblank, <=1024 UTF-16 units, no lone surrogates; leading/trailing whitespace is allowed and preserved."
    },
    "identity": {
      "$anchor": "PlaneInboxIdentity",
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "workspace_id", "project_id", "actor_id", "client_id"],
      "properties": {
        "tenant_id": { "$ref": "#/$defs/ulid" },
        "workspace_id": { "$ref": "#/$defs/ulid" },
        "project_id": { "$ref": "#/$defs/ulid" },
        "actor_id": { "$ref": "#/$defs/identityText" },
        "client_id": { "$ref": "#/$defs/identityText" }
      },
      "description": "Authenticated current or original request identity. Never supplied as an identity override; body identity fields are rejected."
    },
    "recordQuery": {
      "$anchor": "PlaneInboxRecordQuery",
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id"],
      "properties": { "event_id": { "$ref": "#/$defs/ulid" } }
    },
    "summaryQuery": {
      "$anchor": "PlaneInboxSummaryQuery",
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "listQuery": {
      "$anchor": "PlaneInboxListQuery",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["all", "pending", "applied", "rejected"], "default": "all" },
        "pending_state": { "enum": ["all", "due", "delayed", "version_gap"], "default": "all" },
        "aggregate_id": { "$ref": "#/$defs/ulid" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
        "cursor": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,2048}$" }
      },
      "allOf": [
        {
          "if": {
            "required": ["pending_state"],
            "properties": { "pending_state": { "enum": ["due", "delayed", "version_gap"] } }
          },
          "then": { "properties": { "status": { "enum": ["all", "pending"] } } }
        }
      ],
      "description": "Decoded query, defaults only for omitted fields; null is invalid. HTTP names single-valued; limit wire1..3 decimal digits without leading zero then <=100. Non-all pending_state implies pending only, even with status=all."
    },
    "record": {
      "$anchor": "PlaneInboxRecord",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tenant_id",
        "workspace_id",
        "project_id",
        "event_id",
        "event_type",
        "aggregate_type",
        "aggregate_id",
        "aggregate_version",
        "status",
        "attempts",
        "revision",
        "classification",
        "received_at",
        "updated_at",
        "next_attempt_at",
        "applied_at",
        "last_error_code",
        "checked_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "tenant_id": { "$ref": "#/$defs/ulid" },
        "workspace_id": { "$ref": "#/$defs/ulid" },
        "project_id": { "$ref": "#/$defs/ulid" },
        "event_id": { "$ref": "#/$defs/ulid" },
        "event_type": { "type": ["string", "null"] },
        "aggregate_type": { "enum": ["project", "work_item"] },
        "aggregate_id": { "$ref": "#/$defs/ulid" },
        "aggregate_version": { "$ref": "#/$defs/aggregateVersion" },
        "status": { "enum": ["pending", "applied", "rejected"] },
        "attempts": { "$ref": "#/$defs/decimal" },
        "revision": { "$ref": "#/$defs/revision" },
        "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "received_at": { "$ref": "#/$defs/time" },
        "updated_at": { "$ref": "#/$defs/time" },
        "next_attempt_at": { "$ref": "#/$defs/nullableTime" },
        "applied_at": { "$ref": "#/$defs/nullableTime" },
        "last_error_code": { "$ref": "#/$defs/nullableError" },
        "checked_at": { "$ref": "#/$defs/time" }
      },
      "allOf": [
        {
          "if": { "properties": { "aggregate_type": { "const": "project" } } },
          "then": {
            "properties": { "event_type": { "enum": ["ProjectCreated", "ProjectUpdated", null] } }
          },
          "else": {
            "properties": {
              "event_type": {
                "enum": [
                  "WorkItemCreated",
                  "WorkItemUpdated",
                  "WorkItemStatusConfirmed",
                  "WorkItemDeleted",
                  "WorkItemRestored",
                  null
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "pending" } } },
          "then": {
            "properties": {
              "next_attempt_at": { "$ref": "#/$defs/time" },
              "applied_at": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "next_attempt_at": { "type": "null" },
              "attempts": { "not": { "const": "0" } }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "applied" } } },
          "then": {
            "properties": {
              "applied_at": { "$ref": "#/$defs/time" },
              "last_error_code": { "type": "null" }
            }
          },
          "else": { "properties": { "applied_at": { "type": "null" } } }
        },
        {
          "if": { "properties": { "status": { "const": "rejected" } } },
          "then": { "properties": { "last_error_code": { "$ref": "#/$defs/errorCode" } } }
        }
      ],
      "description": "Queue metadata only. event_type=null when selected document type is unsupported/mismatched; metadata reads do not validate the full immutable event. Effective classification is max(event sensitivity,current matching Plane index,parent), unknown levels conservative restricted. Deleted/expired index still contributes classification. Revision is positive bigint queue mutation count, independent of safe positive event version and nonnegative bigint attempts. Parser checks status/null relationships but does not impose general received/updated/applied/checked time chronology."
    },
    "page": {
      "$anchor": "PlaneInboxPage",
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "items"],
      "properties": {
        "scope": { "$ref": "#/$defs/scope" },
        "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#PlaneInboxRecord" } },
        "next_cursor": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,2048}$" }
      },
      "allOf": [
        {
          "if": { "required": ["next_cursor"] },
          "then": { "properties": { "items": { "minItems": 1 } } }
        }
      ],
      "description": "No filter/limit echo, total or has_more. Runtime checks exact scope, strict descending distinct event IDs, status/aggregate/pending filters, <=limit and changed cursor with full page. SQL due<=statement time, delayed>time; millisecond-normalized parser permits equality for both. version_gap reflects last error, not current predecessor absence. Hidden/missing parent yields empty200. Only selected rows normalized/parsed, lookahead not separately validated.",
      "x-cursor": {
        "encoding": "Canonical base64url JSON [1,sha256(stable JSON binding),lastReturnedEventId]",
        "binding": "['plane-inbox-v2',tenant_id,workspace_id,project_id,read_restricted,status,pending_state,aggregate_id-or-null,limit]",
        "semantics": "Binds page size, unlike search/index directories. Does not bind actor/client; not signed or a cross-page snapshot. SQL event_id COLLATE C DESC, not received_at order. Fresh page re-evaluates clock and visibility."
      }
    },
    "summary": {
      "$anchor": "PlaneInboxSummary",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scope",
        "checked_at",
        "counts",
        "oldest_pending_received_at",
        "oldest_due_received_at",
        "earliest_pending_attempt_at",
        "latest_received_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "checked_at": { "$ref": "#/$defs/time" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "pending", "applied", "rejected", "due", "delayed", "version_gap"],
          "properties": {
            "total": { "$ref": "#/$defs/decimal" },
            "pending": { "$ref": "#/$defs/decimal" },
            "applied": { "$ref": "#/$defs/decimal" },
            "rejected": { "$ref": "#/$defs/decimal" },
            "due": { "$ref": "#/$defs/decimal" },
            "delayed": { "$ref": "#/$defs/decimal" },
            "version_gap": { "$ref": "#/$defs/decimal" }
          }
        },
        "oldest_pending_received_at": { "$ref": "#/$defs/nullableTime" },
        "oldest_due_received_at": { "$ref": "#/$defs/nullableTime" },
        "earliest_pending_attempt_at": { "$ref": "#/$defs/nullableTime" },
        "latest_received_at": { "$ref": "#/$defs/nullableTime" }
      },
      "allOf": [
        {
          "if": { "properties": { "counts": { "properties": { "pending": { "const": "0" } } } } },
          "then": {
            "properties": {
              "oldest_pending_received_at": { "type": "null" },
              "earliest_pending_attempt_at": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "oldest_pending_received_at": { "$ref": "#/$defs/time" },
              "earliest_pending_attempt_at": { "$ref": "#/$defs/time" }
            }
          }
        },
        {
          "if": { "properties": { "counts": { "properties": { "due": { "const": "0" } } } } },
          "then": { "properties": { "oldest_due_received_at": { "type": "null" } } },
          "else": { "properties": { "oldest_due_received_at": { "$ref": "#/$defs/time" } } }
        },
        {
          "if": { "properties": { "counts": { "properties": { "total": { "const": "0" } } } } },
          "then": { "properties": { "latest_received_at": { "type": "null" } } },
          "else": { "properties": { "latest_received_at": { "$ref": "#/$defs/time" } } }
        }
      ],
      "description": "One SQL statement snapshot over all visible project rows, independent of directory filters. Runtime bigint arithmetic requires total=pending+applied+rejected, pending=due+delayed, version_gap<=pending. Null times correspond exactly to zero pending/due/total. oldest_pending<=oldest_due<=latest when present; earliest pending attempt<=checked if due>0, otherwise>=checked, allowing equal normalized milliseconds. Hidden/missing parent404; visible empty project returns zero counts. No counts-to-health/upstream completeness implication."
    },
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "has_more"],
      "properties": {
        "items": { "type": "array", "maxItems": 10, "items": { "$ref": "#PlaneInboxRecord" } },
        "has_more": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "has_more": { "const": true } } },
          "then": { "properties": { "items": { "minItems": 10 } } }
        }
      ],
      "description": "Up to10 visible candidates with11th-row lookahead. Only selected10 parsed. Runtime requires same scope/stream/checked_at and requested version, strict ascending unique event IDs. Same-version group excludes target; next-version group may contain target. No continuation cursor."
    },
    "diagnosis": {
      "$anchor": "PlaneInboxDiagnosis",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record",
        "baseline",
        "position",
        "next_version",
        "uncommitted_versions",
        "next_version_candidates",
        "same_version_candidates"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "record": { "$ref": "#PlaneInboxRecord" },
        "baseline": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#PlaneInboxRecord",
            "properties": { "status": { "const": "applied" }, "event_type": { "type": "string" } }
          }
        },
        "position": {
          "enum": [
            "baseline_unavailable",
            "ambiguous_stream",
            "already_recorded",
            "at_or_behind",
            "deleted_stream",
            "next_version",
            "gap"
          ]
        },
        "next_version": { "anyOf": [{ "$ref": "#/$defs/aggregateVersion" }, { "type": "null" }] },
        "uncommitted_versions": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {
                "from": { "$ref": "#/$defs/aggregateVersion" },
                "to": { "$ref": "#/$defs/aggregateVersion" }
              }
            }
          ]
        },
        "next_version_candidates": { "$ref": "#/$defs/candidates" },
        "same_version_candidates": { "$ref": "#/$defs/candidates" }
      },
      "allOf": [
        {
          "if": { "properties": { "position": { "const": "baseline_unavailable" } } },
          "then": { "properties": { "baseline": { "maxItems": 0 } } },
          "else": { "properties": { "baseline": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "position": { "const": "ambiguous_stream" } } },
          "then": { "properties": { "baseline": { "minItems": 2 } } },
          "else": { "properties": { "baseline": { "maxItems": 1 } } }
        },
        {
          "if": { "properties": { "position": { "enum": ["next_version", "gap"] } } },
          "then": { "properties": { "next_version": { "$ref": "#/$defs/aggregateVersion" } } },
          "else": {
            "properties": {
              "next_version": { "type": "null" },
              "next_version_candidates": {
                "properties": { "items": { "maxItems": 0 }, "has_more": { "const": false } }
              }
            }
          }
        },
        {
          "if": { "properties": { "position": { "const": "gap" } } },
          "then": { "properties": { "uncommitted_versions": { "type": "object" } } },
          "else": { "properties": { "uncommitted_versions": { "type": "null" } } }
        }
      ],
      "description": "Single SQL snapshot, no processing locks or repair. Take highest committed supported stream rows (version DESC/event ID ASC LIMIT2), retain highest version, expose baseline only when every selected tip has a visible applied receipt matching event ID/version/type. Never substitute an older visible tip. Empty baseline=>unavailable;2=>ambiguous;1 same target=>already_recorded, target<=tip=>at_or_behind, newer non-delete/non-restore after deleted tip=>deleted_stream, otherwise next=tip+1 and next_version/gap. Gap interval is next..target-1, not proof events never arrived. Related records must share stream/checked_at; repeated target metadata identical; baseline IDs ascending with same version. Comparing metadata does not validate complete canonical events or guarantee retry can apply."
    },
    "listEnvelope": {
      "$anchor": "PlaneInboxListEnvelope",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trace_id", "source_refs", "data"],
      "properties": {
        "schema_version": { "const": 1 },
        "trace_id": { "type": "string", "minLength": 1 },
        "source_refs": { "const": [] },
        "data": { "$ref": "#PlaneInboxPage" }
      }
    },
    "summaryEnvelope": {
      "$anchor": "PlaneInboxSummaryEnvelope",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trace_id", "source_refs", "data"],
      "properties": {
        "schema_version": { "const": 1 },
        "trace_id": { "type": "string", "minLength": 1 },
        "source_refs": { "const": [] },
        "data": { "$ref": "#PlaneInboxSummary" }
      }
    },
    "detailEnvelope": {
      "$anchor": "PlaneInboxDetailEnvelope",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "trace_id",
        "source_refs",
        "data",
        "plane_inbox_identity",
        "plane_inbox_permissions"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "trace_id": { "type": "string", "minLength": 1 },
        "source_refs": { "const": [] },
        "data": { "$ref": "#PlaneInboxRecord" },
        "plane_inbox_identity": { "$ref": "#PlaneInboxIdentity" },
        "plane_inbox_permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retry"],
          "properties": { "retry": { "type": "boolean" } }
        }
      },
      "description": "Current caller identity with same scope as record; retry hint only reflects actor_type=human after trusted-admin authorization, not status/revision/plane.retry policy. SDK parses data/scope/current trace/empty sources but does not independently validate these extra identity/permission fields."
    },
    "diagnosisEnvelope": {
      "$anchor": "PlaneInboxDiagnosisEnvelope",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trace_id", "source_refs", "data"],
      "properties": {
        "schema_version": { "const": 1 },
        "trace_id": { "type": "string", "minLength": 1 },
        "source_refs": { "const": [] },
        "data": { "$ref": "#PlaneInboxDiagnosis" }
      }
    }
  }
}
