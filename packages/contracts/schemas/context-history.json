{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planemem.local/schemas/context-history.json",
  "title": "Context item history reads v1",
  "description": "Complete history-page or recorded-version success envelopes. Historical state and confirmation never grant current write authority.",
  "$comment": "Source-only schema for context-history.ts shared parsers and existing HTTP outputs. Register this complete resource under its ID; no network schema fetch is required. Runtime remains authoritative for UTF-16 lengths, Unicode scalar strings, ordinary finite JSON, valid calendar timestamps, scope/query/trace equality, ordered pagination, source list equality, confirmation equality and recomputed snapshot SHA-256. Shared client limits (4 KiB query, 256 KiB page, 2 MiB revision, 16 KiB error, depth 64 and 100000 nodes for JSON snapshots) are not server HTTP guarantees or JSON Schema assertions. No build, validator, generator or runtime evidence.",
  "oneOf": [{ "$ref": "#ContextHistoryPageEnvelope" }, { "$ref": "#ContextRevisionEnvelope" }],
  "$defs": {
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S",
      "not": { "pattern": "[\\u0000-\\u001f]" },
      "$comment": "Runtime additionally rejects lone surrogates and measures UTF-16 code units; DEL is not rejected by isSyncIdentifier."
    },
    "itemId": { "$ref": "#/$defs/identifier", "not": { "enum": [".", ".."] } },
    "ulid": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26,
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "text": { "type": "string", "not": { "pattern": "\\u0000" } },
    "timestamp": {
      "type": "string",
      "minLength": 24,
      "maxLength": 27,
      "pattern": "^(?:[0-9]{4}|[+-][0-9]{6})-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "$comment": "Exact valid Date.toISOString round-trip is checked at runtime. Extended years are supported; a date-time format limited to four-digit years would be narrower."
    },
    "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "status": { "enum": ["confirmed", "proposed", "expired", "excluded"] },
    "sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$" },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "$ref": "#/$defs/text", "minLength": 1 },
        "id": { "$ref": "#/$defs/text", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "uri": { "$ref": "#/$defs/text", "minLength": 1 }
      },
      "$comment": "uri is nonempty text, not necessarily a validated URI; source revisions can be zero. Shared parser rejects unknown source fields and lone surrogates."
    },
    "ContextHistoryQuery": {
      "$anchor": "ContextHistoryQuery",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "item_id"],
      "properties": {
        "kind": { "const": "history" },
        "item_id": { "$ref": "#/$defs/itemId" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
        "before_version": { "$ref": "#/$defs/positiveInteger" }
      },
      "description": "Decoded shared query. kind is local selection and is not sent as a URL query. Runtime normalizes omitted limit to 25."
    },
    "ContextRevisionQuery": {
      "$anchor": "ContextRevisionQuery",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "item_id", "version"],
      "properties": {
        "kind": { "const": "version" },
        "item_id": { "$ref": "#/$defs/itemId" },
        "version": { "$ref": "#/$defs/positiveInteger" }
      },
      "description": "Decoded shared query; both item_id and version are HTTP path segments. No URL query fields."
    },
    "summaryFields": {
      "type": "object",
      "required": [
        "version",
        "operation",
        "title",
        "classification",
        "status",
        "archived",
        "recorded_at",
        "actor_id",
        "client_id",
        "event_id",
        "snapshot_hash"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/positiveInteger" },
        "operation": { "enum": ["baseline", "create", "update", "archive", "restore", "confirm"] },
        "title": { "$ref": "#/$defs/text" },
        "classification": { "$ref": "#/$defs/classification" },
        "status": { "$ref": "#/$defs/status" },
        "archived": { "type": "boolean" },
        "recorded_at": { "$ref": "#/$defs/timestamp" },
        "actor_id": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "client_id": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
        "event_id": { "oneOf": [{ "$ref": "#/$defs/ulid" }, { "type": "null" }] },
        "snapshot_hash": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "operation": { "const": "baseline" } },
            "required": ["operation"]
          },
          "then": {
            "properties": {
              "actor_id": { "type": "null" },
              "client_id": { "type": "null" },
              "event_id": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "actor_id": { "$ref": "#/$defs/identifier" },
              "client_id": { "$ref": "#/$defs/identifier" },
              "event_id": { "$ref": "#/$defs/ulid" }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "create" } }, "required": ["operation"] },
          "then": {
            "properties": {
              "version": { "const": 1 },
              "status": { "const": "proposed" },
              "archived": { "const": false }
            }
          }
        },
        {
          "if": {
            "properties": { "operation": { "enum": ["update", "archive", "restore", "confirm"] } },
            "required": ["operation"]
          },
          "then": { "properties": { "version": { "minimum": 2 } } }
        },
        {
          "if": { "properties": { "operation": { "const": "update" } }, "required": ["operation"] },
          "then": {
            "properties": {
              "status": { "enum": ["proposed", "excluded"] },
              "archived": { "const": false }
            }
          }
        },
        {
          "if": {
            "properties": { "operation": { "const": "archive" } },
            "required": ["operation"]
          },
          "then": {
            "properties": { "status": { "const": "excluded" }, "archived": { "const": true } }
          }
        },
        {
          "if": {
            "properties": { "operation": { "const": "restore" } },
            "required": ["operation"]
          },
          "then": {
            "properties": { "status": { "const": "excluded" }, "archived": { "const": false } }
          }
        },
        {
          "if": {
            "properties": { "operation": { "const": "confirm" } },
            "required": ["operation"]
          },
          "then": {
            "properties": { "status": { "const": "confirmed" }, "archived": { "const": false } }
          }
        }
      ],
      "$comment": "Open internal composition only; public summary and revision anchors close all fields. Baseline records preserve a previously saved version without inventing a command actor/client/event. Operation-state constraints describe the shared parser; the legacy Gateway does not run this complete parser."
    },
    "ContextRevisionSummary": {
      "$anchor": "ContextRevisionSummary",
      "$ref": "#/$defs/summaryFields",
      "unevaluatedProperties": false
    },
    "ContextSnapshotDocument": {
      "$anchor": "ContextSnapshotDocument",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tenant_id",
        "workspace_id",
        "project_id",
        "title",
        "content",
        "source_refs",
        "source_ref",
        "item_type",
        "layer",
        "classification",
        "status",
        "priority",
        "confidence",
        "expires_at",
        "version",
        "trace_id",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/itemId" },
        "tenant_id": { "$ref": "#/$defs/ulid" },
        "workspace_id": { "$ref": "#/$defs/ulid" },
        "project_id": { "$ref": "#/$defs/ulid" },
        "title": { "$ref": "#/$defs/text" },
        "content": {
          "description": "Saved arbitrary JSON including null, arrays or objects; legacy snapshots are not constrained to the text-only create/edit input. Ordinary finite JSON and aggregate limits are enforced by the shared runtime parser."
        },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "source_ref": { "$ref": "#/$defs/text" },
        "item_type": { "$ref": "#/$defs/text" },
        "layer": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
        "classification": { "$ref": "#/$defs/classification" },
        "status": { "$ref": "#/$defs/status" },
        "priority": { "enum": ["High", "Medium", "Low"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "expires_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "version": { "$ref": "#/$defs/positiveInteger" },
        "trace_id": { "$ref": "#/$defs/identifier" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      },
      "$comment": "Immutable stored document only: no live source checks, confirm_allowed, nested confirmation hints or ETag. Scope matches the requested project; updated_at >= created_at is a runtime cross-field check. Saved trace can differ from this read's outer trace."
    },
    "ContextHistoricalConfirmation": {
      "$anchor": "ContextHistoricalConfirmation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_version",
        "confirmed_version",
        "actor_id",
        "client_id",
        "event_id",
        "reason",
        "confirmed_at"
      ],
      "properties": {
        "reviewed_version": { "$ref": "#/$defs/positiveInteger" },
        "confirmed_version": { "$ref": "#/$defs/positiveInteger", "minimum": 2 },
        "actor_id": { "$ref": "#/$defs/identifier" },
        "client_id": { "$ref": "#/$defs/identifier" },
        "event_id": { "$ref": "#/$defs/ulid" },
        "reason": {
          "$ref": "#/$defs/text",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "not": { "pattern": "\\s$" }
        },
        "confirmed_at": { "$ref": "#/$defs/timestamp" }
      },
      "$comment": "Runtime requires reviewed_version=summary.version-1, confirmed_version=summary.version, actor/client/event/time exactly matching summary, and a trimmed reason of at most 2000 UTF-16 code units."
    },
    "ContextRevision": {
      "$anchor": "ContextRevision",
      "$ref": "#/$defs/summaryFields",
      "required": ["item", "archived_at"],
      "properties": {
        "item": { "$ref": "#ContextSnapshotDocument" },
        "archived_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "confirmation": {
          "oneOf": [{ "$ref": "#ContextHistoricalConfirmation" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "operation": { "const": "confirm" } },
            "required": ["operation"]
          },
          "then": {
            "required": ["confirmation"],
            "properties": { "confirmation": { "$ref": "#ContextHistoricalConfirmation" } }
          },
          "else": { "properties": { "confirmation": { "type": "null" } } }
        },
        {
          "if": { "properties": { "archived": { "const": true } }, "required": ["archived"] },
          "then": { "properties": { "archived_at": { "$ref": "#/$defs/timestamp" } } },
          "else": { "properties": { "archived_at": { "type": "null" } } }
        }
      ],
      "unevaluatedProperties": false,
      "$comment": "Gateway emits confirmation:null for non-confirm operations; shared parser also accepts omission. Snapshot item id/scope/version/title/classification/status must match selection and summary. Canonical SHA-256 hashes {item,archived_at}, recursively sorting object keys but preserving array order; it excludes summary attribution and confirmation. Hash self-consistency is not a signature or external-source verification."
    },
    "ContextHistoryPage": {
      "$anchor": "ContextHistoryPage",
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "current_version", "current_archived", "versions"],
      "properties": {
        "item_id": { "$ref": "#/$defs/itemId" },
        "current_version": { "$ref": "#/$defs/positiveInteger" },
        "current_archived": { "type": "boolean" },
        "versions": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#ContextRevisionSummary" }
        },
        "next_before_version": { "$ref": "#/$defs/positiveInteger", "minimum": 2 }
      },
      "$comment": "Versions strictly descend, each <= current_version and below optional before_version; count <= requested limit. An entry at current_version matches current_archived. Continuation is present only for a full page with lookahead, equals its last version and is >1; otherwise omitted, not null. Each page has its own repeatable-read snapshot; filtering/gaps can skip versions."
    },
    "ContextHistoryPageEnvelope": {
      "$anchor": "ContextHistoryPageEnvelope",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trace_id", "source_refs", "data"],
      "properties": {
        "schema_version": { "const": 1 },
        "trace_id": { "$ref": "#/$defs/identifier" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id"],
            "properties": {
              "type": { "const": "context-item" },
              "id": { "$ref": "#/$defs/itemId" }
            }
          }
        },
        "data": { "$ref": "#ContextHistoryPage" }
      },
      "$comment": "Outer source ID and data.item_id equal the requested item. Outer trace equals the read trace. No outer revision, etag or server_cursor."
    },
    "ContextRevisionEnvelope": {
      "$anchor": "ContextRevisionEnvelope",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trace_id", "source_refs", "data"],
      "properties": {
        "schema_version": { "const": 1 },
        "trace_id": { "$ref": "#/$defs/identifier" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "id", "revision"],
              "properties": {
                "type": { "const": "context-item" },
                "id": { "$ref": "#/$defs/itemId" },
                "revision": { "$ref": "#/$defs/positiveInteger" }
              }
            }
          ],
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "data": { "$ref": "#ContextRevision" }
      },
      "$comment": "Outer sources exactly equal [{type:context-item,id:requested item,revision:requested version},...data.item.source_refs] in order, including duplicates. Outer trace equals read trace; no outer revision/etag/server_cursor. Schema does not calculate the snapshot hash."
    }
  }
}
